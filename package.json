{
  "name": "manatee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "lint": "oxlint --deny-warnings src scripts tests vite.config.ts playwright.config.ts",
    "format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.{html,json,ts,mjs}\" \".github/**/*.yml\"",
    "format:write": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.{html,json,ts,mjs}\" \".github/**/*.yml\"",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run format && npm run lint && npm run check:boundaries && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.7",
    "ajv": "8.20.0",
    "solid-js": "2.0.0-rc.7",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.40",
    "@types/node": "24.13.4",
    "jsdom": "29.1.1",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
