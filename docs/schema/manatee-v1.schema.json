{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlperrott.github.io/manatee/schema/manatee-v1.schema.json",
  "title": "Manatee presentation metadata version 1",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "layout": { "$ref": "#/$defs/layout" },
    "elements": { "$ref": "#/$defs/elements" },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "nonNegativeNumber": { "type": "number", "minimum": 0 },
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "scalar": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" }
      ]
    },
    "colour": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    },
    "lineStyle": {
      "enum": ["solid", "dashed", "dotted"]
    },
    "textStyle": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/$defs/colour" },
        "size": { "$ref": "#/$defs/positiveNumber" },
        "weight": { "enum": [400, 500, 600, 700] },
        "italic": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "outlineStyle": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/$defs/colour" },
        "width": { "$ref": "#/$defs/positiveNumber" },
        "style": { "$ref": "#/$defs/lineStyle" }
      },
      "additionalProperties": true
    },
    "nodeStyle": {
      "type": "object",
      "properties": {
        "fill": { "$ref": "#/$defs/colour" },
        "outline": { "$ref": "#/$defs/outlineStyle" },
        "text": { "$ref": "#/$defs/textStyle" }
      },
      "additionalProperties": true
    },
    "relationshipLineStyle": {
      "type": "object",
      "properties": {
        "color": { "$ref": "#/$defs/colour" },
        "width": { "$ref": "#/$defs/positiveNumber" },
        "style": { "$ref": "#/$defs/lineStyle" }
      },
      "additionalProperties": true
    },
    "relationshipStyle": {
      "type": "object",
      "properties": {
        "style": { "$ref": "#/$defs/relationshipLineStyle" },
        "text": { "$ref": "#/$defs/textStyle" }
      },
      "additionalProperties": true
    },
    "containerStyle": {
      "type": "object",
      "properties": {
        "fill": { "$ref": "#/$defs/colour" },
        "outline": { "$ref": "#/$defs/outlineStyle" },
        "text": { "$ref": "#/$defs/textStyle" }
      },
      "additionalProperties": true
    },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/nonNegativeNumber" },
        "y": { "$ref": "#/$defs/nonNegativeNumber" }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "properties": {
        "spacing": {
          "type": "object",
          "properties": {
            "node": { "$ref": "#/$defs/nonNegativeNumber" },
            "layer": { "$ref": "#/$defs/nonNegativeNumber" },
            "groupPadding": { "$ref": "#/$defs/nonNegativeNumber" },
            "lane": { "$ref": "#/$defs/nonNegativeNumber" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "nodeEntry": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "style": { "$ref": "#/$defs/nodeStyle" }
      },
      "additionalProperties": true
    },
    "containerEntry": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/position" },
        "style": { "$ref": "#/$defs/containerStyle" }
      },
      "additionalProperties": true
    },
    "relationshipEntry": {
      "allOf": [{ "$ref": "#/$defs/relationshipStyle" }]
    },
    "relationshipMatcher": {
      "type": "object",
      "required": ["source", "target", "kind"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "matchedRelationshipEntry": {
      "type": "object",
      "required": ["match"],
      "properties": {
        "match": { "$ref": "#/$defs/relationshipMatcher" },
        "style": { "$ref": "#/$defs/relationshipLineStyle" },
        "text": { "$ref": "#/$defs/textStyle" }
      },
      "additionalProperties": true
    },
    "elements": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nodeEntry" }
        },
        "relationships": {
          "type": "object",
          "properties": {
            "byId": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/relationshipEntry" }
            },
            "byEndpoints": {
              "type": "array",
              "items": { "$ref": "#/$defs/matchedRelationshipEntry" }
            }
          },
          "additionalProperties": true
        },
        "groups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/containerEntry" }
        },
        "lanes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/containerEntry" }
        }
      },
      "additionalProperties": true
    },
    "attributePredicate": {
      "oneOf": [
        {
          "type": "object",
          "required": ["eq"],
          "properties": { "eq": { "$ref": "#/$defs/scalar" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["in"],
          "properties": {
            "in": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/scalar" }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["gt"],
          "properties": { "gt": { "type": "number" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["gte"],
          "properties": { "gte": { "type": "number" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["lt"],
          "properties": { "lt": { "type": "number" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["lte"],
          "properties": { "lte": { "type": "number" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["exists"],
          "properties": { "exists": { "type": "boolean" } },
          "additionalProperties": false
        }
      ]
    },
    "ruleMatcher": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "attributes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/attributePredicate" }
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "required": ["match", "style"],
      "properties": {
        "match": { "$ref": "#/$defs/ruleMatcher" },
        "style": { "$ref": "#/$defs/nodeStyle" }
      },
      "additionalProperties": true
    }
  }
}
